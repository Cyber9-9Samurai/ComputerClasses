<UserControl x:Class="ComputerClasses.Views.Notifications.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ComputerClasses.Views.Notifications"
             xmlns:notif="clr-namespace:ComputerClasses.ViewModels.Notifications"
             xmlns:converter="clr-namespace:ComputerClasses.Converters"
             xmlns:anim="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance notif:NotificationsViewModel}">

    <UserControl.Resources>
        <converter:NotificationItemVisabilityConverter x:Key="notifItemVis" />
    </UserControl.Resources>

    <Grid Height="Auto" Width="Auto">

        <Button x:Name="not"
                Style="{StaticResource NotificationButton}"
                Width="80"
                Height="80"
                Margin="0 0 10 0"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Command="{Binding NotificationButton.NavCommand}">

            <WrapPanel>

                <Image Width="80"
                       Height="80"
                       Source="{Binding NotificationButton.Image}">
                </Image>

                <Ellipse Width="10"
                         Height="10"
                         VerticalAlignment="Bottom"
                         Margin="-140 0 0 0"
                         Fill="#00BCD4"
                         Visibility="{Binding HasNotifications, Converter={StaticResource notifItemVis}}" />

            </WrapPanel>
        </Button>

        <Border CornerRadius="12"
                Background="#B2CACACA"
                Margin="0 100 100 0"
                MinHeight="150"
                MinWidth="300"
                ClipToBounds="True"
                Visibility="{Binding IsOpen, Converter={StaticResource notifItemVis}}">

            <ScrollViewer MinHeight="150"
                          MinWidth="300"
                          Background="Transparent"
                          Visibility="{Binding IsOpen, Converter={StaticResource notifItemVis}}">

                <ItemsControl MinHeight="150"
                              MinWidth="120"
                              Background="Transparent"
                              ItemsSource="{Binding Notifications}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <WrapPanel Width="Auto"
                                       Margin="10 10 0 0"
                                       Visibility="{Binding IsVisible,
                                                            Converter={StaticResource notifItemVis},
                                                            Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}">

                                <TextBlock Width="Auto"
                                           Text="{Binding Message}" />

                                <Button Content="Скрыть"
                                        Command="{Binding DataContext.HideNotificationCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding .}" />

                            </WrapPanel>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
