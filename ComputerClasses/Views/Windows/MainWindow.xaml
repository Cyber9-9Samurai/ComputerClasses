<Window x:Class="ComputerClasses.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ComputerClasses.Views.Windows"
        xmlns:nav="clr-namespace:ComputerClasses.Views.Navigation" 
        xmlns:vm="clr-namespace:ComputerClasses.ViewModels.Windows"
        xmlns:converter="clr-namespace:ComputerClasses.Converters"
        xmlns:navigator="https://navigation.mvvm/"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">
    <Window.Resources>
        <converter:PopupVisibilityConverter x:Key="popupVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <nav:NavigationMenuView Grid.Row="0" DataContext="{Binding NavigationMenu}"/>
        <Grid Grid.Row="1">
            <ContentControl Content="{Binding NavigatorPage.CurrentViewModel}"/>
        </Grid>
        <Grid Background="Black" Opacity="0.6" Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding NavigatorPopup.CurrentViewModel,Converter={StaticResource popupVis}}">
            <ContentControl Content="{Binding NavigatorPopup.CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
