<UserControl x:Class="ComputerClasses.Views.Navigation.NavigationMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ComputerClasses.Views.Navigation"
             xmlns:anim="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
             xmlns:b="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
             xmlns:vm="clr-namespace:ComputerClasses.ViewModels.Navigation"
             xmlns:converter="clr-namespace:ComputerClasses.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:NavigationMenuViewModel}">
    <UserControl.Resources>
        <converter:EventArgsAndDataConverter x:Key="conv"/>
    </UserControl.Resources>
    <Grid>
        <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="20 20 0 0" >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding NavCommand}" Width="110" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <Image Width="45" Height="45"
                                anim:ImageBehavior.AnimatedSource="{Binding Image}"
                                anim:ImageBehavior.AutoStart="False">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="Loaded">
                                        <b:InvokeCommandAction 
                                            Command="{Binding DataContext.LoadImageCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            PassEventArgsToCommand="True">
                                        </b:InvokeCommandAction>
                                    </b:EventTrigger>
                                    <b:EventTrigger EventName="MouseEnter">
                                        <b:InvokeCommandAction Command="{Binding DataContext.PlayCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                            CommandParameter="{Binding .}"/>
                                    </b:EventTrigger>
                                </b:Interaction.Triggers >
                            </Image>
                            <TextBlock Text="{Binding Title}" TextAlignment="Center" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
