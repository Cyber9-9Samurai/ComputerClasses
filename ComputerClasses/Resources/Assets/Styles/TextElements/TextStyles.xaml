<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="HiText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="Red"/>
    </Style>
    <Style x:Key="AddItemTemplate" TargetType="TextBox" >
        <Setter Property="Width" Value="157"/>
        <Setter Property="Height" Value="27" />
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style x:Key="InputInPopup" TargetType="TextBox">
        <Setter Property="Width" Value="184"/>
        <Setter Property="Height" Value="27" />
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style x:Key="Content" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0 10 0 0" /> 
    </Style>
</ResourceDictionary>