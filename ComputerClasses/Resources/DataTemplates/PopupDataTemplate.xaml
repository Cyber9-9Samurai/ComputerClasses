<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ComputerClasses.ViewModels.Popups"
                    xmlns:view="clr-namespace:ComputerClasses.Views.Popups">
    <DataTemplate DataType="{x:Type vm:TestPopupViewModel}">
        <view:TestPopup DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EmptyPopupViewModel}">
        <view:EmptyPopupView DataContext="{Binding}"/>
    </DataTemplate>
</ResourceDictionary>