<Application x:Class="ComputerClasses.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ComputerClasses" 
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/DataTemplates/PageDataTemplate.xaml"/>
                <ResourceDictionary Source="/Resources/DataTemplates/PopupDataTemplate.xaml"/>
                <ResourceDictionary Source="/Resources/Assets/Styles/TextElements/TextStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
